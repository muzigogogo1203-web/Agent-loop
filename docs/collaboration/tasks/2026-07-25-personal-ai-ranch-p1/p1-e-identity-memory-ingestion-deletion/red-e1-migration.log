        value ?? "null"
    }
}

private enum MatrixDiagnosticMessage: CaseIterable {
    case null
    case present

    var value: String? {
        switch self {
        case .null:
            return nil
        case .present:
            return "safe message"
        }
    }

    var label: String {
        switch self {
