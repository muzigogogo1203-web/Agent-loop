        switch self {
        case .succeededWithoutOutput, .succeededWithOutput, .failed, .canceled:
            return 1_000_001
        case .queued, .running, .retryScheduled:
            return nil
        }
    }
}

private enum MatrixDiagnosticAttemptShape: String, CaseIterable {
