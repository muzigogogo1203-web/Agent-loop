    expect_sqlite_failure "$sqlite_cli" "$success_database" \
        "UPDATE domain_command_receipt SET commandType=commandType WHERE idempotencyKey='$prefix-command';" \
        "$lane literal receipt no-op update"
    expect_sqlite_failure "$sqlite_cli" "$success_database" \
