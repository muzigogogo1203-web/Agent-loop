    ) else {
        throw MatrixError.assertion("\(label) returned no row")
    }
    return value
}

private func requiredDouble(
    _ database: Database,
    sql: String,
    arguments: StatementArguments = [],
    label: String
) throws -> Double {
    guard let value = try Double.fetchOne(
        database,
