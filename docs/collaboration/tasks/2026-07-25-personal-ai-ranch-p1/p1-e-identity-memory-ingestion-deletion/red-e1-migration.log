            timestamp,
            timestamp,
        ]
    )
    try database.execute(
        sql: """
            INSERT INTO durable_work_attempt (
              workId, attempt, id, workerId, startedAt, endedAt, outcome,
              errorCode, errorMessage, traceId, terminalWorkVersion
            ) VALUES (?, 1, ?, 'worker', ?, NULL, NULL, NULL, NULL, ?, NULL)
            """,
        arguments: [
