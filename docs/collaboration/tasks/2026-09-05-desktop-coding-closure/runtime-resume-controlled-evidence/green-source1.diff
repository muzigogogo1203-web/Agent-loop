+private func p1f1d065RunControlledWaitChild(evidence: URL) async throws {
+    let gate = P1F1D065SynchronousGate()
+    let gateState = P1F1D065ControlledWaitState()
+    let gateController = p1f1d065StartControlledWaitController(
+        state: gateState,
+        hasEntered: { gate.controlledWaitCounts.entries != 0 },
+        release: {
+            gate.release()
+            return 1
+        }
+    )
+    await gateState.waitUntilControllerStarted()
+    let sink = P1F1D065BlockingProgressSink(gate: gate)
+    let gateWaiter = Task {
+        try await sink.submit(.progress(message: "controlled wait"))
+    }
+    gateWaiter.cancel()
+    let gateWasCancelled = gateWaiter.isCancelled
+    let gateResult = await gateWaiter.result
+    let gateControl = await gateController.value
+    if let sibling = gateControl.sibling { await sibling.value }
+    let gateCounts = gate.controlledWaitCounts
+
+    // Set up the socket only after the gate's complete ownership has joined.
+    // No no-rescue assertion may prevent this second real boundary running.
+    var pair = [Int32](repeating: -1, count: 2)
+    guard Darwin.socketpair(AF_UNIX, SOCK_STREAM, 0, &pair) == 0 else {
+        throw P1F1D065ControlledWaitError.setup(["socketpair errno=\(errno)"])
+    }
+    guard PosixSockets.disableSIGPIPE(pair[1]) else {
+        var failures = ["peer SO_NOSIGPIPE errno=\(errno)"]
+        for descriptor in pair {
+            if Darwin.close(descriptor) != 0 {
+                failures.append("close setup descriptor errno=\(errno)")
+            }
+        }
+        throw P1F1D065ControlledWaitError.setup(failures)
+    }
+    let client = P1F1D065SocketClient(ownedDescriptor: pair[0])
+    let peer = pair[1]
+    let socketState = P1F1D065ControlledWaitState()
+    let socketController = p1f1d065StartControlledWaitController(
+        state: socketState,
+        hasEntered: { socketState.hasEnteredRead },
+        release: { try p1f1d065WriteAndCloseControlledPeer(peer) }
+    )
+    await socketState.waitUntilControllerStarted()
+    let socketWaiter = Task {
+        try await p1f1d065ReadResultLinesUntilEOF(
+            client,
+            onReadEntered: { socketState.enterRead() },
+            onLine: { line in
+                socketState.append(line)
+            }
+        )
+        socketState.finishRead()
+    }
+    socketWaiter.cancel()
+    let socketWasCancelled = socketWaiter.isCancelled
+    let socketResult = await socketWaiter.result
+    let socketControl = await socketController.value
+    if let sibling = socketControl.sibling { await sibling.value }
+    let readerClose = Result { try client.closeChecked() }
+    let read = socketState.readResult
+
+    print(
+        "065 CONTROLLED WAIT PHASES "
+            + "gate-cancelled=\(gateWasCancelled) "
+            + "gate-entry=\(gateCounts.entries) gate-release=\(gateCounts.releases) "
+            + "gate-sibling=\(gateState.hasProgressed) "
+            + "gate-rescue=\(gateControl.rescueUsed) "
+            + "gate-entry-timeout=\(gateControl.entryTimedOut) "
+            + "socket-cancelled=\(socketWasCancelled) "
+            + "socket-entry=\(socketState.hasEnteredRead) "
+            + "socket-lines=\(read.lines) socket-eof=\(read.reachedEOF) "
+            + "socket-sibling=\(socketState.hasProgressed) "
+            + "socket-rescue=\(socketControl.rescueUsed) "
+            + "socket-entry-timeout=\(socketControl.entryTimedOut) "
+            + "controllers-and-siblings-joined=true"
+    )
+    try gateResult.get()
+    try socketResult.get()
+    try readerClose.get()
+    let gateRelease = try gateControl.release.get()
+    let bytesWritten = try socketControl.release.get()
+    try #require(gateWasCancelled && socketWasCancelled)
+    try #require(gateCounts.entries == 1 && gateCounts.releases == 1)
+    try #require(gateRelease == 1)
+    try #require(!gateControl.entryTimedOut && !socketControl.entryTimedOut)
+    try #require(gateControl.sibling != nil && socketControl.sibling != nil)
+    try #require(gateState.hasProgressed && socketState.hasProgressed)
+    try #require(socketState.hasEnteredRead && read.reachedEOF)
+    try #require(bytesWritten == 27)
+    try #require(read.lines == ["first-result", "second-result"])
+    // All ownership and both boundary outcomes are established before RED.
+    try #require(!gateControl.rescueUsed && !socketControl.rescueUsed)
+    try Data("065-controlled-waits-ok\n".utf8).write(
+        to: evidence, options: .withoutOverwriting
+    )
+}
