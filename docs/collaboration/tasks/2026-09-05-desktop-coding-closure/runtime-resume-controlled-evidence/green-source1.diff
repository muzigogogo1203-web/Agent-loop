+private let p1f1d065ControlledWaitEvidenceKey =
+    "AGENTLOOP_065_CONTROLLED_WAIT_EVIDENCE"
+private let p1f1d065ControlledWaitLabel = "065-controlled-wait-child"
+
+private enum P1F1D065ControlledWaitError: Error {
+    case invalidChildEnvironment
+    case invalidEvidencePath
+    case setup([String])
+}
+
+private final class P1F1D065ControlledWaitState: @unchecked Sendable {
+    private let lock = NSLock()
+    private var readEntered = false
+    private var reachedEOF = false
+    private var siblingProgressed = false
+    private var lines: [String] = []
+    private var controllerStarted = false
+    private var controllerStartWaiter: CheckedContinuation<Void, Never>?
+
+    func enterRead() { lock.withLock { readEntered = true } }
+    func finishRead() { lock.withLock { reachedEOF = true } }
+    func append(_ line: String) { lock.withLock { lines.append(line) } }
+    func progress() { lock.withLock { siblingProgressed = true } }
+    var hasEnteredRead: Bool { lock.withLock { readEntered } }
+    var hasProgressed: Bool { lock.withLock { siblingProgressed } }
+    var readResult: (lines: [String], reachedEOF: Bool) {
+        lock.withLock { (lines, reachedEOF) }
+    }
+
+    func markControllerStarted() {
+        let waiter = lock.withLock {
+            precondition(!controllerStarted)
+            controllerStarted = true
+            let waiter = controllerStartWaiter
+            controllerStartWaiter = nil
+            return waiter
+        }
+        waiter?.resume()
+    }
+
+    func waitUntilControllerStarted() async {
+        await withCheckedContinuation { continuation in
+            let started = lock.withLock {
+                if controllerStarted { return true }
+                precondition(controllerStartWaiter == nil)
+                controllerStartWaiter = continuation
+                return false
+            }
+            if started { continuation.resume() }
+        }
+    }
+}
+
+private struct P1F1D065ControlledWaitControllerReport: Sendable {
+    let entryTimedOut: Bool
+    let rescueUsed: Bool
+    let sibling: Task<Void, Never>?
+    let release: Result<Int, any Error>
+}
+
+// This controller has its own native worker; it must be able to release the
+// real wait even when the selected strict-pool child pins its only worker.
+private func p1f1d065StartControlledWaitController(
+    state: P1F1D065ControlledWaitState,
+    hasEntered: @escaping @Sendable () -> Bool,
+    release: @escaping @Sendable () throws -> Int
+) -> Task<P1F1D065ControlledWaitControllerReport, Never> {
+    BlockingProcessOperation.start {
+        state.markControllerStarted()
+        let entryDeadline = ContinuousClock.now.advanced(by: .seconds(5))
+        while !hasEntered(), ContinuousClock.now < entryDeadline {
+            Thread.sleep(forTimeInterval: 0.001)
+        }
+        let entered = hasEntered()
+        var sibling: Task<Void, Never>?
+        var rescueUsed = false
+        if entered {
+            sibling = Task.detached { state.progress() }
+            let progressDeadline = ContinuousClock.now.advanced(
+                by: .seconds(1)
+            )
+            while !state.hasProgressed,
+                  ContinuousClock.now < progressDeadline
+            {
+                Thread.sleep(forTimeInterval: 0.001)
+            }
+            rescueUsed = !state.hasProgressed
+        }
+        return P1F1D065ControlledWaitControllerReport(
+            entryTimedOut: !entered,
+            rescueUsed: rescueUsed,
+            sibling: sibling,
+            release: Result { try release() }
+        )
+    }
+}
