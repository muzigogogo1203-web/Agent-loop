+private func p1f1d065WriteAndCloseControlledPeer(
+    _ peer: Int32
+) throws -> Int {
+    let bytes = Array("first-result\nsecond-result\n".utf8)
+    var failures: [String] = []
+    var offset = 0
+    bytes.withUnsafeBytes { buffer in
+        guard let base = buffer.baseAddress else { return }
+        while offset < buffer.count {
+            let count = Darwin.write(
+                peer, base.advanced(by: offset), buffer.count - offset
+            )
+            if count < 0, errno == EINTR { continue }
+            guard count > 0 else {
+                let errorNumber = count < 0 ? errno : 0
+                failures.append("write peer count=\(count) errno=\(errorNumber)")
+                break
+            }
+            offset += count
+        }
+    }
+    if Darwin.close(peer) != 0 {
+        failures.append("close peer errno=\(errno)")
+    }
+    guard failures.isEmpty else {
+        throw P1F1D065ControlledWaitError.setup(failures)
+    }
+    return offset
+}
