+// Negative-case arrangement only: the input was actually deleted by its domain command.
+// This schema-valid NULL/redacted fixture makes each independent corruption reachable
+// before production hooks exist; the positive deletion tests prove the hooks themselves.
+private func desktopRetentionArrangeDeletedCarrier(
+    _ database: AppDatabase, intent: DesktopGoalCaptureIntentV1
+) throws {
+    try database.pool.write { db in
+        let inputValue = try InputEnvelopeRecord.fetchOne(db, key: intent.context.inputId)
+        let input = try #require(inputValue)
+        #expect(input.status == .deletedTombstone)
+        #expect(input.retentionState == .deletedTombstone)
+        try db.execute(sql: "UPDATE desktop_goal_context SET retentionState='redacted',contextJson=NULL WHERE inputId=?", arguments: [input.id])
+        try db.execute(sql: "UPDATE desktop_goal_operation SET phase='redacted',requestJson=NULL,resultJson=NULL WHERE inputId=?", arguments: [input.id])
+    }
+}
