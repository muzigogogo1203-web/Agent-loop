+        if (n < 0 && errno == EINTR) continue;
+        if (n < 0) { api_error("capture_poll", pid, n, 0, errno); io_ok = false; bytes_complete = false; break; }
+        for (int i = 0; i < 2; ++i) if (fds[i].revents) {
