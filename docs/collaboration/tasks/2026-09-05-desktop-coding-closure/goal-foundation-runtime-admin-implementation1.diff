+            r->child.pbi_pid, r->child.pbi_start_tvsec, r->child.pbi_start_tvusec);
+    return fflush(stdout) == 0 ? 0 : 3;
+}
+
+static bool frame(const char *role, const unsigned char *bytes, size_t count) {
+    static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    if (fprintf(stdout, "{\"event\":\"stream\",\"role\":\"%s\",\"base64\":\"", role) < 0) return false;
+    for (size_t i = 0; i < count; i += 3) {
+        uint32_t v = (uint32_t)bytes[i] << 16;
+        if (i + 1 < count) v |= (uint32_t)bytes[i + 1] << 8;
+        if (i + 2 < count) v |= bytes[i + 2];
+        char out[4] = { alphabet[(v >> 18) & 63], alphabet[(v >> 12) & 63],
+                        i + 1 < count ? alphabet[(v >> 6) & 63] : '=',
+                        i + 2 < count ? alphabet[v & 63] : '=' };
+        if (fwrite(out, 1, 4, stdout) != 4) return false;
+    }
+    return fputs("\"}\n", stdout) >= 0 && fflush(stdout) == 0;
+}
+
+/* This PID is always the one positive PID returned by this process's fork.
+ * Never pass a target, discovered process, process group, or reaped PID here. */
+static pid_t tool_wait(pid_t pid, int *status) {
+    errno = 0; pid_t got = waitpid(pid, status, WNOHANG); int e = errno;
+    fprintf(stderr, "{\"event\":\"tool_wait\",\"mono\":%" PRIu64 ",\"pid\":%d,\"result\":%d,\"errno\":%d}\n", mono(), pid, got, e);
+    errno = e; return got;
+}
+
+static pid_t tool_wait_until(pid_t pid, int *status, uint64_t deadline) {
+    for (;;) {
+        pid_t got = tool_wait(pid, status);
+        if (got == pid || (got < 0 && errno != EINTR)) return got;
+        uint64_t now = mono();
+        if (now >= deadline) return 0;
+        uint64_t next = now + INTERVAL_NS;
+        if (next > deadline) next = deadline;
+        if (!pause_until(next)) return -1;
+    }
+}
+
+static bool signal_owned_tool(pid_t pid, const struct proc_bsdinfo *pin, int sig) {
+    struct proc_bsdinfo now;
+    bool valid = pid > 1 && pin->pbi_pid == (uint32_t)pid
+        && pin->pbi_ppid == (uint32_t)getpid() && bsd(pid, &now, true)
+        && same_generation(pin, &now);
+    int result = -1, e = 0;
+    if (valid) { errno = 0; result = kill(pid, sig); e = errno; }
+    fprintf(stderr, "{\"event\":\"tool_signal\",\"mono\":%" PRIu64 ",\"pid\":%d,\"signal\":%d,\"identity_valid\":%d,\"result\":%d,\"errno\":%d}\n",
+            mono(), pid, sig, valid, result, e);
+    return valid && result == 0;
+}
