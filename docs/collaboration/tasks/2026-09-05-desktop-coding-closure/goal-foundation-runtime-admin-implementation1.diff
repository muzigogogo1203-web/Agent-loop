+static int capture(struct request *r) {
+    if (geteuid() != 0) return refuse("privilege");
+    uint64_t age;
+    if (!chain(r) || !age_us(&r->child, &age) || age > 2000000) return refuse("final_guard");
+    int pipes[2][2] = {{-1, -1}, {-1, -1}};
