+    }
+    struct proc_bsdinfo after; errno = 0;
+    bool available = bsd((pid_t)r->child.pbi_pid, &after, true);
+    bool same = available && same_generation(&r->child, &after);
+    int exit_code = waited == pid && WIFEXITED(status) ? WEXITSTATUS(status) : -1;
