+            mono(), pid, r->child.pbi_pid, tool_pinned, tool.pbi_ppid, tool.pbi_uid, tool.pbi_ruid,
+            tool.pbi_pgid, tool.pbi_start_tvsec, tool.pbi_start_tvusec);
+    while (pipes[0][0] >= 0 || pipes[1][0] >= 0) {
+        if (mono() >= deadline) { deadline_expired = true; bytes_complete = false; break; }
+        if (waited == 0) {
+            waited = tool_wait(pid, &status);
+            if (waited < 0 && errno == EINTR) waited = 0;
+            else if (waited < 0) { io_ok = false; bytes_complete = false; break; }
+        }
+        struct pollfd fds[2] = {{pipes[0][0], POLLIN, 0}, {pipes[1][0], POLLIN, 0}};
