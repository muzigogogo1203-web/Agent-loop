+    }
+    #expect(failures.primary as? CliMechanicsForcedBodyFailure == .afterReady)
+    #expect(failures.cleanupFailures.isEmpty)
+    #expect(removalAllowed)
     #expect(signatureRevalidator.snapshot() == [.cli, .boardBridge])
 }
 
