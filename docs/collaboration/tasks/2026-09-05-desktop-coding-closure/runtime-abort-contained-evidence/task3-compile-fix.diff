+    var information = siginfo_t()
+    let result = Darwin.waitid(P_PID, identifier, &information, WEXITED | WNOHANG | WNOWAIT)
+    let errorNumber = result == 0 ? 0 : errno
+    return .init(operation: "waitid-WEXITED-WNOHANG-WNOWAIT", target: pid,
+                 result: result, errorNumber: errorNumber, waitablePID: information.si_pid)
+}
