+private func p1f1d065ContainFreshAbortIdentity(
+    _ identity: P1F1D065AbortProcessIdentity,
+    context: P1F1D065AbortProcessContext
+) -> P1F1D065AbortContainmentReport {
+    var observations: [P1F1D065AbortSyscallObservation] = []
+    var diagnosticErrors: [any Error] = []
+    let result = Result { () throws -> Void in
+        func observe(_ signal: Int32, operation: String) throws -> P1F1D065AbortSyscallObservation {
+            let observation = p1f1d065AbortObserveSignal(target: identity.pid, signal: signal, operation: operation)
+            observations.append(observation)
+            return observation
+        }
+        let before = try observe(0, operation: "containment-probe-before")
+        if before.absent { return }
+        guard before.result == 0 else {
+            throw P1F1D065ColdObservationError(operation: before.operation, result: before.result, errorNumber: before.errorNumber)
+        }
+        guard try p1f1d065CaptureAbortProcessIdentity(pid: identity.pid, authority: context.authority) == identity else {
+            throw P1F1D065AbortIdentityError.identityDrift
+        }
+        let killed = try observe(SIGKILL, operation: "containment-SIGKILL-positive-pid")
+        guard killed.result == 0 || killed.absent else {
+            throw P1F1D065ColdObservationError(operation: killed.operation, result: killed.result, errorNumber: killed.errorNumber)
+        }
+        let afterKill = try observe(0, operation: "containment-probe-after-kill")
+        if afterKill.absent { return }
+        guard afterKill.result == 0 else {
+            throw P1F1D065ColdObservationError(operation: afterKill.operation, result: afterKill.result, errorNumber: afterKill.errorNumber)
+        }
+        guard try p1f1d065CaptureAbortProcessIdentity(pid: identity.pid, authority: context.authority) == identity else {
+            throw P1F1D065AbortIdentityError.identityDrift
+        }
+        let continued = try observe(SIGCONT, operation: "containment-SIGCONT-positive-pid")
+        guard continued.result == 0 || continued.absent else {
+            throw P1F1D065ColdObservationError(operation: continued.operation, result: continued.result, errorNumber: continued.errorNumber)
+        }
+    }
+    // Diagnostic IO cannot stand between validation and an emergency signal.
+    for observation in observations {
+        do { try p1f1d065AbortLogObservation(observation, scope: context.scope) }
+        catch { diagnosticErrors.append(error) }
+    }
+    return .init(observations: observations, result: result, diagnosticErrors: diagnosticErrors)
+}
