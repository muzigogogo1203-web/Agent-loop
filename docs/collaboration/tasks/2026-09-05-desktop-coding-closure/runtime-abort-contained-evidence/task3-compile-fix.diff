+private func p1f1d065AbortObserveWait(_ pid: pid_t) throws -> P1F1D065AbortSyscallObservation {
+    guard pid > 1, let identifier = id_t(exactly: pid) else {
+        throw P1F1D065AbortIdentityError.invalid("waitid-identity")
