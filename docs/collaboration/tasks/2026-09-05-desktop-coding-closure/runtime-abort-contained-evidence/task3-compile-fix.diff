+private func p1f1d065ValidateAbortFile(
+    _ information: stat, authority: CliExecutableAuthorityV1
+) throws {
+    guard information.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG),
+          let device = UInt64(exactly: information.st_dev),
+          let inode = UInt64(exactly: information.st_ino),
+          let uid = uid_t(exactly: information.st_uid),
+          device == authority.stagedDevice, inode == authority.stagedInode,
+          uid == getuid(), information.st_size >= 0
+    else { throw P1F1D065AbortIdentityError.invalid("staged-file-authority") }
+}
