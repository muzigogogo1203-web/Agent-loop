+private func p1f1d065CaptureAbortProcessIdentity(
+    pid: pid_t, authority: CliExecutableAuthorityV1
+) throws -> P1F1D065AbortProcessIdentity {
+    let first = try p1f1d065ReadAbortBSDIdentity(pid: pid, phase: "before")
+    // The SDK macro is 4 * MAXPATHLEN (PATH_MAX), but Swift cannot import it.
+    var pathBytes = [CChar](repeating: 0, count: 4 * Int(PATH_MAX))
+    guard let pathSize = UInt32(exactly: pathBytes.count) else {
+        throw P1F1D065AbortIdentityError.invalid("process-path-size")
+    }
+    let pathResult = pathBytes.withUnsafeMutableBytes { proc_pidpath(pid, $0.baseAddress, pathSize) }
+    let pathError = pathResult > 0 ? 0 : errno
+    guard pathResult > 0, let pathCount = Int(exactly: pathResult), pathCount < pathBytes.count else {
+        throw P1F1D065ColdObservationError(
+            operation: "abort-proc-pidpath", result: pathResult, errorNumber: pathError
+        )
+    }
+    let processPath = String(decoding: pathBytes.prefix { $0 != 0 }.map { UInt8(bitPattern: $0) }, as: UTF8.self)
+    let canonicalProcess = try p1f1d065AbortCanonicalPath(processPath)
+    let canonicalStaged = try p1f1d065AbortCanonicalPath(authority.stagedPath)
+    guard canonicalProcess == canonicalStaged else {
+        throw P1F1D065AbortIdentityError.invalid("process-executable-path")
+    }
+    let hash = try p1f1d065ReadAbortExecutableHash(path: canonicalStaged, authority: authority)
+    let second = try p1f1d065ReadAbortBSDIdentity(pid: pid, phase: "after")
+    guard first == second else { throw P1F1D065AbortIdentityError.identityDrift }
+    return .init(
+        pid: second.pid, parentPID: second.parent, processGroupID: second.group,
+        uid: second.uid, startSeconds: second.seconds, startMicroseconds: second.microseconds,
+        executablePath: canonicalStaged, executableDevice: authority.stagedDevice,
+        executableInode: authority.stagedInode, executableHash: hash
+    )
+}
