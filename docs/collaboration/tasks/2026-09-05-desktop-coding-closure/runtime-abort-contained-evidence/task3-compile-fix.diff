+private func p1f1d065ReadAbortExecutableHash(
+    path: String, authority: CliExecutableAuthorityV1
+) throws -> String {
+    var before = stat()
+    let inspected = path.withCString { Darwin.lstat($0, &before) }
+    guard inspected == 0 else {
+        throw P1F1D065ColdObservationError(
+            operation: "abort-staged-lstat", result: inspected, errorNumber: errno
+        )
+    }
+    try p1f1d065ValidateAbortFile(before, authority: authority)
+    let descriptor = path.withCString { Darwin.open($0, O_RDONLY | O_NOFOLLOW | O_CLOEXEC) }
+    guard descriptor >= 0 else {
+        throw P1F1D065ColdObservationError(
+            operation: "abort-staged-open", result: descriptor, errorNumber: errno
+        )
+    }
+    let body = Result { () throws -> String in
+        var opened = stat()
+        let openedResult = Darwin.fstat(descriptor, &opened)
+        guard openedResult == 0 else {
+            throw P1F1D065ColdObservationError(
+                operation: "abort-staged-fstat", result: openedResult, errorNumber: errno
+            )
+        }
+        try p1f1d065ValidateAbortFile(opened, authority: authority)
+        guard opened.st_dev == before.st_dev, opened.st_ino == before.st_ino,
+              opened.st_size == before.st_size,
+              opened.st_mtimespec.tv_sec == before.st_mtimespec.tv_sec,
+              opened.st_mtimespec.tv_nsec == before.st_mtimespec.tv_nsec
+        else { throw P1F1D065AbortIdentityError.identityDrift }
+        var data = Data()
+        var buffer = [UInt8](repeating: 0, count: 4096)
+        while true {
+            let count = buffer.withUnsafeMutableBytes { Darwin.read(descriptor, $0.baseAddress, $0.count) }
+            let errorNumber = count < 0 ? errno : 0
+            if count == 0 { break }
+            if count < 0 && errorNumber == EINTR { continue }
+            guard count > 0 else {
+                throw P1F1D065ColdObservationError(
+                    operation: "abort-staged-read", result: -1, errorNumber: errorNumber
+                )
+            }
+            data.append(contentsOf: buffer.prefix(count))
+        }
+        var after = stat()
+        let afterResult = Darwin.fstat(descriptor, &after)
+        guard afterResult == 0 else {
+            throw P1F1D065ColdObservationError(
+                operation: "abort-staged-fstat-after", result: afterResult, errorNumber: errno
+            )
+        }
+        try p1f1d065ValidateAbortFile(after, authority: authority)
+        guard after.st_size == opened.st_size,
+              after.st_mtimespec.tv_sec == opened.st_mtimespec.tv_sec,
+              after.st_mtimespec.tv_nsec == opened.st_mtimespec.tv_nsec,
+              let byteCount = Int64(exactly: data.count), byteCount == after.st_size
+        else { throw P1F1D065AbortIdentityError.identityDrift }
+        let hash = CanonicalJSONV1.sha256Hex(data)
+        guard hash == authority.executableHash else {
+            throw P1F1D065AbortIdentityError.invalid("staged-hash")
+        }
+        return hash
+    }
+    let closed = Darwin.close(descriptor)
+    let closeError = closed == 0 ? 0 : errno
+    guard closed == 0 else {
+        let primary: (any Error)?
+        if case .failure(let error) = body { primary = error } else { primary = nil }
+        throw P1F1D065ColdCleanupError(
+            primary: primary,
+            cleanupFailures: [.init(operation: "abort-staged-close", error:
+                P1F1D065ColdObservationError(operation: "close", result: closed, errorNumber: closeError))],
+            retainedFixturePath: nil
+        )
+    }
+    return try body.get()
+}
