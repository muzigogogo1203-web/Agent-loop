+private func p1f1d065ReadAbortBSDIdentity(
+    pid: pid_t, phase: String
+) throws -> P1F1D065AbortBSDIdentity {
+    guard pid > 1, let size = Int32(exactly: MemoryLayout<proc_bsdinfo>.size) else {
+        throw P1F1D065AbortIdentityError.invalid("pid-or-bsd-size")
+    }
+    var information = proc_bsdinfo()
+    let result = withUnsafeMutablePointer(to: &information) {
+        proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, $0, size)
+    }
+    let errorNumber = result == size ? 0 : errno
+    guard result == size else {
+        throw P1F1D065ColdObservationError(
+            operation: "abort-bsd-\(phase)", result: result, errorNumber: errorNumber
+        )
+    }
+    guard let observedPID = pid_t(exactly: information.pbi_pid),
+          let parent = pid_t(exactly: information.pbi_ppid),
+          let group = pid_t(exactly: information.pbi_pgid),
+          let uid = uid_t(exactly: information.pbi_uid),
+          let seconds = UInt64(exactly: information.pbi_start_tvsec),
+          let microseconds = UInt32(exactly: information.pbi_start_tvusec),
+          observedPID == pid, parent == getpid(), group == pid,
+          uid == getuid(), seconds != 0 || microseconds != 0,
+          microseconds < 1_000_000
+    else { throw P1F1D065AbortIdentityError.invalid("direct-child-kernel-tuple") }
+    return .init(pid: observedPID, parent: parent, group: group, uid: uid,
+                 seconds: seconds, microseconds: microseconds)
+}
