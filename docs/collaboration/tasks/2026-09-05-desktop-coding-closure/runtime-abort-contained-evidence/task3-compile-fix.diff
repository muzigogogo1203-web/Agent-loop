+private func p1f1d065AbortCanonicalPath(_ path: String) throws -> String {
+    guard path.hasPrefix("/"), !path.utf8.contains(0) else {
+        throw P1F1D065AbortIdentityError.invalid("absolute-path")
+    }
+    var bytes = [CChar](repeating: 0, count: Int(PATH_MAX))
+    let resolved = path.withCString { Darwin.realpath($0, &bytes) }
+    guard resolved != nil else {
+        throw P1F1D065ColdObservationError(
+            operation: "abort-realpath", result: -1, errorNumber: errno
+        )
+    }
+    return String(decoding: bytes.prefix { $0 != 0 }.map { UInt8(bitPattern: $0) }, as: UTF8.self)
+}
