+private func p1f1d065AbortOwnerTestOperations(
+    testCase: P1F1D065AbortOwnerTestCase,
+    client: P1F1D065SocketClient?,
+    control: P1F1D065AbortSafetyControl,
+    probe: P1F1D065AbortOwnerTestProbe
+) -> P1F1D065AbortOwnerOperations {
+    .init(
+        startStreamWaiter: {
+            probe.start(control.snapshot.guardStarted)
+            return Task {
+                switch testCase {
+                case .expiry, .readerStarted:
+                    break
+                case .hello, .clientConstruction:
+                    // Publication enters first; observing missing-image entry
+                    // therefore proves BOTH native waiters are controlled.
+                    _ = await control.publicationGate.waitUntilEnteredOrCompleted()
+                }
+                let error = await p1f1d065AbortOwnerTestWait(
+                    gate: control.missingImageGate, testCase: testCase,
+                    probe: probe, label: "stream"
+                )
+                return P1F1D065ControlledStreamReport(frames: [], terminalError: error)
+            }
+        },
+        startCancellationWaiter: {
+            probe.start(control.snapshot.guardStarted)
+            return Task {
+                let error = await p1f1d065AbortOwnerTestWait(
+                    gate: control.publicationGate, testCase: testCase,
+                    probe: probe, label: "cancellation"
+                )
+                return P1F1D065CleanupPublicationReport(
+                    terminalError: error,
+                    // No fixture, registry, or process exists in this unit.
+                    resources: .init(
+                        cleanupRemoved: false, socketRemoved: false,
+                        registryEmpty: false, directoryClose: .notAttempted
+                    )
+                )
+            }
+        },
+        makeClient: {
+            if case .clientConstruction = testCase {
+                throw P1F1D065AbortOwnerTestError.clientConstruction
+            }
+            guard let client else {
+                throw P1F1D065AbortSafetyError.unexpectedOperation
+            }
+            return client
+        },
+        connect: { _ in
+            // socketpair already supplies the connection; preserve the same
+            // asynchronous POSIX boundary used by the real owner operations.
+            try await p1f1d065AwaitSynchronousBoundary {}
+        },
+        performHello: { _ in
+            try await p1f1d065AwaitSynchronousBoundary {
+                if case .readerStarted = testCase { return }
+                throw P1F1D065AbortOwnerTestError.hello
+            }
+        },
+        sendToolCall: { _ in
+            try await p1f1d065AwaitSynchronousBoundary {
+                guard case .readerStarted = testCase else {
+                    throw P1F1D065AbortSafetyError.unexpectedOperation
+                }
+            }
+        },
+        startReader: { client in
+            Task {
+                do {
+                    guard case .readerStarted = testCase else {
+                        throw P1F1D065AbortSafetyError.unexpectedOperation
+                    }
+                    try await p1f1d065ReadResultLinesUntilEOF(
+                        client, abortControl: control,
+                        onReadEntered: {
+                            probe.enterReader()
+                            control.publicationGate.complete(.reader)
+                        }
+                    )
+                    return .success(())
+                } catch {
+                    return .failure(error)
+                }
+            }
+        }
+    )
+}
