+private func p1f1d065RequireAbortOwnerTestResources(
+    _ result: P1F1D065AbortOwnerTestReport,
+    testCase: P1F1D065AbortOwnerTestCase
+) throws {
+    let epilogue = result.epilogue
+    // All tasks and descriptors have been joined/closed before any throwing
+    // assertion. A failed cleanup remains an explicit stored Result.
+    if let unadopted = result.unadoptedClientClose { try unadopted.get() }
+    if let peerClose = result.peerClose { try peerClose.get() }
+    if let shutdown = epilogue.clientShutdown { try shutdown.get() }
+    if let close = epilogue.clientClose { try close.get() }
+    try #require(result.unadoptedClientClose == nil)
+    try #require(epilogue.claimAccepted)
+    try #require(result.starts == [true, true])
+    let stream = try #require(epilogue.stream)
+    let cancellation = try #require(epilogue.cancellation)
+    try #require(stream.frames.isEmpty)
+    try #require((stream.terminalError as? P1F1D065AbortSafetyError) == .gateAborted)
+    if case .readerStarted = testCase {
+        let cancellationError = try #require(
+            cancellation.terminalError as? P1F1D065AbortSafetyError
+        )
+        switch cancellationError {
+        case .gateCompleted(.reader):
+            try #require(result.outcomes == ["stream": "aborted", "cancellation": "completed-reader"])
+        case .gateAborted:
+            try #require(result.outcomes == ["stream": "aborted", "cancellation": "aborted"])
+        default:
+            try #require(Bool(false), "unexpected typed cancellation outcome")
+        }
+        let reader = try #require(epilogue.reader)
+        try reader.get()
+        try #require(result.owner.lifetime.reader != nil && result.readerEntries == 1)
+    } else {
+        try #require(result.outcomes == ["stream": "aborted", "cancellation": "aborted"])
+        try #require((cancellation.terminalError as? P1F1D065AbortSafetyError) == .gateAborted)
+        try #require(epilogue.reader == nil && result.owner.lifetime.reader == nil)
+        try #require(result.readerEntries == 0)
+    }
+    let guardReport = try #require(epilogue.guardReport)
+    try #require(epilogue.guardDisarmed)
+    let control = result.owner.lifetime.control
+    try #require(control.snapshot.guardStarted && control.snapshot.guardFinished)
+    try #require(control.snapshot.lateClientShutdown == nil)
+    let missing = try #require(epilogue.missingImage?.abortObservation)
+    let publication = try #require(epilogue.publication?.abortObservation)
+    let missingFirsts = (missing.firstAbort ? 1 : 0)
+        + (guardReport.missingImageAbort?.firstAbort == true ? 1 : 0)
+    let publicationFirsts = (publication.firstAbort ? 1 : 0)
+        + (guardReport.publicationAbort?.firstAbort == true ? 1 : 0)
+    try #require(missingFirsts == 1 && publicationFirsts == 1)
+    try #require(!result.repeatedMissingAbort.firstAbort)
+    try #require(!result.repeatedPublicationAbort.firstAbort)
+    let missingCounts = control.missingImageGate.controlledWaitCounts
+    let publicationCounts = control.publicationGate.controlledWaitCounts
+    try #require(missingCounts.releases == 0 && publicationCounts.releases == 0)
+    var bodyError: (any Error)?
+    if case .failure(let error) = result.owner.body { bodyError = error }
+    switch testCase {
+    case .hello:
+        try #require((bodyError as? P1F1D065AbortOwnerTestError) == .hello)
+        try #require(epilogue.clientShutdown != nil && epilogue.clientClose != nil)
+        try #require(result.peerClose != nil && control.snapshot.clientInstalled)
+    case .clientConstruction:
+        try #require((bodyError as? P1F1D065AbortOwnerTestError) == .clientConstruction)
+        try #require(epilogue.clientShutdown == nil && epilogue.clientClose == nil)
+        try #require(result.peerClose == nil && !control.snapshot.clientInstalled)
+    case .expiry:
+        try #require((bodyError as? P1F1D065AbortSafetyError) == .gateAborted)
+        try #require(epilogue.clientShutdown == nil && epilogue.clientClose == nil)
+        try #require(result.peerClose == nil && !control.snapshot.clientInstalled)
+    case .readerStarted:
+        try #require((bodyError as? P1F1D065AbortSafetyError) == .gateCompleted(.reader))
+        try #require(epilogue.clientShutdown != nil && epilogue.clientClose != nil)
+        try #require(result.peerClose != nil && control.snapshot.clientInstalled)
+    }
+    if case .expiry = testCase {
+        try #require(guardReport.expired && control.snapshot.expiryCount == 1)
+        try #require(missingCounts.entries == 0 && publicationCounts.entries == 0)
+        try #require(guardReport.missingImageAbort != nil && guardReport.publicationAbort != nil)
+        try #require(guardReport.clientShutdown == nil)
+    } else {
+        try #require(!guardReport.expired && control.snapshot.expiryCount == 0)
+        try #require(missingCounts.entries == 1 && missing.hadEntered)
+        if case .readerStarted = testCase {
+            try #require(publicationCounts.entries == 0 && !publication.hadEntered)
+        } else {
+            try #require(publicationCounts.entries == 1 && publication.hadEntered)
+        }
+        try #require(guardReport.missingImageAbort == nil && guardReport.publicationAbort == nil)
+        try #require(guardReport.clientShutdown == nil)
+    }
+}
