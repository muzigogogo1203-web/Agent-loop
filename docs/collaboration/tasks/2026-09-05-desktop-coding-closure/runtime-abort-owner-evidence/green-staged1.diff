+private func p1f1d065RunAbortOwnerTestCase(
+    _ testCase: P1F1D065AbortOwnerTestCase
+) async throws -> P1F1D065AbortOwnerTestReport {
+    let missing = P1F1D065SynchronousGate()
+    let publication = P1F1D065SynchronousGate()
+    let control = P1F1D065AbortSafetyControl(
+        missingImageGate: missing, publicationGate: publication
+    )
+    let probe = P1F1D065AbortOwnerTestProbe()
+    let client: P1F1D065SocketClient?
+    let peer: Int32?
+    switch testCase {
+    case .hello, .readerStarted:
+        var pair = [Int32](repeating: -1, count: 2)
+        guard Darwin.socketpair(AF_UNIX, SOCK_STREAM, 0, &pair) == 0 else {
+            throw P1F1D065ColdObservationError(
+                operation: "abort-owner-test-socketpair", result: -1,
+                errorNumber: errno
+            )
+        }
+        client = P1F1D065SocketClient(ownedDescriptor: pair[0])
+        peer = pair[1]
+    case .clientConstruction, .expiry:
+        client = nil
+        peer = nil
+    }
+    let budget: Duration
+    if case .expiry = testCase { budget = .milliseconds(25) }
+    else { budget = .seconds(30) }
+    let owner = await p1f1d065RunAbortOwner(
+        control: control, budget: budget,
+        operations: p1f1d065AbortOwnerTestOperations(
+            testCase: testCase, client: client, control: control, probe: probe
+        ),
+        publicationObserved: { false }
+    )
+    // No assertion or throw may skip this PRE-RED rescue. GREEN must use
+    // the owner's epilogue, never this rescue, with the same test bodies.
+    let epilogue: P1F1D065AbortEpilogueReport
+    if let owned = owner.epilogue {
+        epilogue = owned
+    } else {
+        epilogue = await p1f1d065RunAbortEpilogue(
+            claimant: .testRescue, bodySucceeded: false,
+            lifetime: owner.lifetime
+        )
+    }
+    let unadoptedClose: Result<Void, any Error>?
+    if let client, owner.lifetime.client == nil {
+        unadoptedClose = Result { try client.closeChecked() }
+    } else {
+        unadoptedClose = nil
+    }
+    let peerClose: Result<Void, any Error>? = peer.map { descriptor in
+        Result {
+            let result = Darwin.close(descriptor)
+            let errorNumber = result == 0 ? 0 : errno
+            guard result == 0 else {
+                throw P1F1D065ColdObservationError(
+                    operation: "abort-owner-test-peer-close", result: result,
+                    errorNumber: errorNumber
+                )
+            }
+        }
+    }
+    let observed = probe.snapshot
+    return .init(
+        owner: owner, epilogue: epilogue,
+        peerClose: peerClose, unadoptedClientClose: unadoptedClose,
+        repeatedMissingAbort: missing.abortWake(),
+        repeatedPublicationAbort: publication.abortWake(),
+        starts: observed.starts, outcomes: observed.outcomes,
+        readerEntries: observed.readerEntries
+    )
+}
