+// Task 1 owns only test gates and a client. Process identity and containment
+// are intentionally not implemented or admitted by this no-child unit.
+private final class P1F1D065AbortSafetyControl: @unchecked Sendable {
+    let missingImageGate: P1F1D065SynchronousGate
+    let publicationGate: P1F1D065SynchronousGate
+    private let lock = NSLock()
+    private let disarmSignal = DispatchSemaphore(value: 0)
+    private var client: P1F1D065SocketClient?
+    private var lateClientShutdown: Result<Void, any Error>?
+    private var started = false
+    private var finished = false
+    private var disarmed = false
+    private var expiryCount = 0
+    private var startWaiters: [CheckedContinuation<Void, Never>] = []
+
+    init(
+        missingImageGate: P1F1D065SynchronousGate,
+        publicationGate: P1F1D065SynchronousGate
+    ) {
+        self.missingImageGate = missingImageGate
+        self.publicationGate = publicationGate
+    }
+
+    var isAborted: Bool { lock.withLock { expiryCount != 0 } }
+
+    var snapshot: P1F1D065AbortSafetySnapshot {
+        lock.withLock {
+            .init(
+                guardStarted: started, guardFinished: finished,
+                expiryCount: expiryCount, clientInstalled: client != nil,
+                lateClientShutdown: lateClientShutdown
+            )
+        }
+    }
+
+    func installClient(_ installed: P1F1D065SocketClient) -> Result<Void, any Error> {
+        let installedResult: Result<Bool, any Error> = lock.withLock {
+            guard client == nil else {
+                return .failure(P1F1D065AbortSafetyError.clientAlreadyInstalled)
+            }
+            client = installed
+            return .success(expiryCount != 0)
+        }
+        switch installedResult {
+        case .failure(let error): return .failure(error)
+        case .success(false): return .success(())
+        case .success(true):
+            let shutdown = installed.interruptReadChecked()
+            lock.withLock { lateClientShutdown = shutdown }
+            return .failure(P1F1D065AbortSafetyError.gateAborted)
+        }
+    }
+
+    func waitUntilGuardStarted() async {
+        await withCheckedContinuation { continuation in
+            let alreadyStarted = lock.withLock {
+                if started { return true }
+                startWaiters.append(continuation)
+                return false
+            }
+            if alreadyStarted { continuation.resume() }
+        }
+    }
+
+    func disarm() -> Bool {
+        let first = lock.withLock {
+            let first = !disarmed
+            disarmed = true
+            return first
+        }
+        disarmSignal.signal()
+        return first
+    }
+
+    func waitAndExpire(after budget: Duration) -> P1F1D065AbortGuardReport {
+        let waiters = lock.withLock {
+            precondition(!started)
+            started = true
+            let waiters = startWaiters
+            startWaiters.removeAll()
+            return waiters
+        }
+        waiters.forEach { $0.resume() }
+        let deadline = ContinuousClock.now.advanced(by: budget)
+        while !lock.withLock({ disarmed }), ContinuousClock.now < deadline {
+            // Dispatch deadlines are monotonic. Wall-clock jumps cannot
+            // extend the guard, unlike an NSCondition Date-based wait.
+            _ = disarmSignal.wait(timeout: .now() + .milliseconds(25))
+        }
+        let expiry: (claimed: Bool, client: P1F1D065SocketClient?) = lock.withLock {
+            guard !disarmed else { return (false, nil) }
+            precondition(expiryCount == 0)
+            expiryCount = 1
+            return (true, client)
+        }
+        let missing = expiry.claimed ? missingImageGate.abortWake() : nil
+        let publication = expiry.claimed ? publicationGate.abortWake() : nil
+        let shutdown = expiry.client?.interruptReadChecked()
+        lock.withLock { finished = true }
+        return .init(
+            expired: expiry.claimed,
+            missingImageAbort: missing, publicationAbort: publication,
+            clientShutdown: shutdown
+        )
+    }
+}
