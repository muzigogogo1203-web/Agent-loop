+private func p1f1d065RunAbortBody(
+    operations: P1F1D065AbortOwnerOperations,
+    lifetime: P1F1D065AbortLifetime,
+    publicationObserved: @Sendable () -> Bool
+) async -> Result<P1F1D065AbortBodyObservation, any Error> {
+    do {
+        let control = lifetime.control
+        try await p1f1d065RequireAbortGateEntry(control.missingImageGate)
+        let client = try await p1f1d065AwaitSynchronousBoundary {
+            try operations.makeClient()
+        }
+        lifetime.client = client
+        try control.installClient(client).get()
+        try await operations.connect(client)
+        try await operations.performHello(client)
+        try await operations.sendToolCall(client)
+        lifetime.reader = operations.startReader(client)
+        try await p1f1d065RequireAbortGateEntry(control.publicationGate)
+        control.missingImageGate.releaseOwnedOnce()
+        let published = publicationObserved()
+        control.publicationGate.releaseOwnedOnce()
+        return .success(.init(publishedBeforeCleanup: published))
+    } catch {
+        return .failure(error)
+    }
+}
+
+private func p1f1d065RunAbortEpilogue(
+    claimant: P1F1D065AbortCleanupClaimant,
+    bodySucceeded: Bool,
+    lifetime: P1F1D065AbortLifetime
+) async -> P1F1D065AbortEpilogueReport {
+    let claimed = lifetime.claim(claimant)
+    var report = P1F1D065AbortEpilogueReport(
+        claimant: claimant, claimAccepted: claimed
+    )
+    guard claimed else { return report }
+    let control = lifetime.control
+    if bodySucceeded {
+        report.missingImage = .ordinaryRelease(
+            first: control.missingImageGate.releaseOwnedOnce()
+        )
+        report.publication = .ordinaryRelease(
+            first: control.publicationGate.releaseOwnedOnce()
+        )
+    } else {
+        report.missingImage = .aborted(control.missingImageGate.abortWake())
+        report.publication = .aborted(control.publicationGate.abortWake())
+    }
+    report.clientShutdown = lifetime.client?.interruptReadChecked()
+    if let reader = lifetime.reader { report.reader = await reader.value }
+    report.cancellation = await lifetime.cancellation.value
+    report.stream = await lifetime.stream.value
+    report.guardDisarmed = control.disarm()
+    report.guardReport = await lifetime.guardTask.value
+    if let client = lifetime.client {
+        report.clientClose = Result { try client.closeChecked() }
+    }
+    return report
+}
