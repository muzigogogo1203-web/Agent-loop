+private func p1f1d065RunAbortOwner(
+    control: P1F1D065AbortSafetyControl,
+    budget: Duration,
+    operations: P1F1D065AbortOwnerOperations,
+    publicationObserved: @Sendable () -> Bool
+) async -> P1F1D065AbortOwnerReport {
+    let guardTask = p1f1d065StartAbortGuard(control: control, budget: budget)
+    await control.waitUntilGuardStarted()
+    let lifetime = P1F1D065AbortLifetime(
+        control: control, guardTask: guardTask, operations: operations
+    )
+    let body = await p1f1d065RunAbortBody(
+        operations: operations, lifetime: lifetime,
+        publicationObserved: publicationObserved
+    )
+    let bodySucceeded: Bool
+    if case .success = body {
+        bodySucceeded = true
+    } else {
+        bodySucceeded = false
+    }
+    let epilogue = await p1f1d065RunAbortEpilogue(
+        claimant: .owner, bodySucceeded: bodySucceeded, lifetime: lifetime
+    )
+    return .init(body: body, epilogue: epilogue, lifetime: lifetime)
+}
