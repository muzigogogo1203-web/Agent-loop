+private enum P1F1D065AbortOwnerTestError: Error, Sendable, Equatable {
+    case hello
+    case clientConstruction
+}
+
+private enum P1F1D065AbortOwnerTestCase: Sendable {
+    case hello
+    case clientConstruction
+    case expiry
+    case readerStarted
+}
+
+private final class P1F1D065AbortOwnerTestProbe: @unchecked Sendable {
+    private let lock = NSLock()
+    private var startAcknowledgements: [Bool] = []
+    private var outcomes: [String: String] = [:]
+    private var readerEntries = 0
+
+    func start(_ acknowledged: Bool) {
+        lock.withLock { startAcknowledgements.append(acknowledged) }
+    }
+
+    func finish(_ label: String, outcome: String) {
+        lock.withLock { outcomes[label] = outcome }
+    }
+
+    func enterReader() { lock.withLock { readerEntries += 1 } }
+
+    var snapshot: (starts: [Bool], outcomes: [String: String], readerEntries: Int) {
+        lock.withLock { (startAcknowledgements, outcomes, readerEntries) }
+    }
+}
+
+private func p1f1d065AbortOwnerTestWait(
+    gate: P1F1D065SynchronousGate,
+    testCase: P1F1D065AbortOwnerTestCase,
+    probe: P1F1D065AbortOwnerTestProbe,
+    label: String
+) async -> (any Error)? {
+    do {
+        if case .readerStarted = testCase, label == "cancellation" {
+            switch await gate.waitUntilEnteredOrCompleted() {
+            case .completed(.reader):
+                probe.finish(label, outcome: "completed-reader")
+                throw P1F1D065AbortSafetyError.gateCompleted(.reader)
+            case .aborted:
+                probe.finish(label, outcome: "aborted")
+                throw P1F1D065AbortSafetyError.gateAborted
+            case .entered, .completed:
+                probe.finish(label, outcome: "unexpected")
+                throw P1F1D065AbortSafetyError.unexpectedOperation
+            }
+        }
+        if case .expiry = testCase {
+            switch await gate.waitUntilEnteredOrCompleted() {
+            case .aborted:
+                probe.finish(label, outcome: "aborted")
+                throw P1F1D065AbortSafetyError.gateAborted
+            case .entered, .completed:
+                probe.finish(label, outcome: "unexpected")
+                throw P1F1D065AbortSafetyError.unexpectedOperation
+            }
+        }
+        let ordinarilyReleased = try await p1f1d065AwaitSynchronousBoundary {
+            gate.enterAndWait()
+        }
+        probe.finish(label, outcome: ordinarilyReleased ? "released" : "aborted")
+        guard ordinarilyReleased else {
+            throw P1F1D065AbortSafetyError.gateAborted
+        }
+        return nil
+    } catch {
+        return error
+    }
+}
