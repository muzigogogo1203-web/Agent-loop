+        let effects = harness.processInspector.effectSnapshot
+        try #require(effects.snapshotCalls == 0)
+        try #require(effects.signalCount == 0)
+        try #require(harness.processInspector.signalObservations().isEmpty)
+        try #require(!FileManager.default.fileExists(atPath: socketURL.path))
+        let observedReplacement = try Data(contentsOf: cleanup.url)
