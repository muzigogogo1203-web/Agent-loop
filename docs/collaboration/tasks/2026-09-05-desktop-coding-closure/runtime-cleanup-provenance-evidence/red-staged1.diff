+            catch { Issue.record(error) }
+        }
+        let executionId = "00000000-0000-4000-8000-000000000765"
+        let cleanup = try harness.makeCleanupAuthority("cleanup.json")
+        let retainedOriginalURL = harness.root.appendingPathComponent(
+            "cleanup-original.json"
+        )
+        try FileManager.default.moveItem(
+            at: cleanup.url, to: retainedOriginalURL
+        )
+        let replacementBytes = Data("replacement-must-survive".utf8)
+        try replacementBytes.write(to: cleanup.url)
+        let request = try harness.request(
+            executionId: executionId,
+            mode: .exitZero,
+            token: "7",
+            cleanupAuthorities: [cleanup.authority]
+        )
+        let socketURL = try harness.socketURL(executionId: executionId)
+        let registry = ShellProcessRegistry()
+        let revalidator = P1F1D065SignatureRevalidator(
+            expectedCLI: harness.executableAuthority,
+            expectedBoardBridge: harness.bridgeAuthority,
+            injectedFailure: .cli
+        )
+        let backend = try p1f1d065GateBackend(
+            harness: harness, registry: registry, revalidator: revalidator
+        )
+        var terminalError: (any Error)?
+        var frameCount = 0
+        do {
+            for try await _ in backend.launch(request) { frameCount += 1 }
+        } catch {
+            terminalError = error
+        }
+
+        // Establish all resource and zero-effect evidence before the intended
+        // RED cast: cleanup must preserve a file outside the captured identity.
+        try #require(revalidator.snapshot() == [.cli])
+        try #require(frameCount == 0)
