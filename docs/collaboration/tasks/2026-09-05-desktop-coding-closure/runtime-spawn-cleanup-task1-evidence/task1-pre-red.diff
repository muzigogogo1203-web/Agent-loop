+private enum P1F1D065SpawnCleanupSentinel: Error, Sendable, Equatable {
+    case unrelatedProbe, continuation, unexpectedCall
+}
+
+private enum P1F1D065SpawnCleanupError: Equatable {
+    case authority(Int32)
+    case backend(CliProcessBackendError)
+    case sentinel(P1F1D065SpawnCleanupSentinel)
+    case unexpected(String)
+
+    init(_ error: any Error) {
+        if case .processSignal(let number)? = error as? EngineRuntimeAuthorityErrorV1 {
+            self = .authority(number)
+        } else if let error = error as? CliProcessBackendError {
+            self = .backend(error)
+        } else if let error = error as? P1F1D065SpawnCleanupSentinel {
+            self = .sentinel(error)
+        } else {
+            self = .unexpected(String(reflecting: type(of: error)))
+        }
+    }
+}
+
+private enum P1F1D065SpawnCleanupProbe: Equatable {
+    case live, absent, failure(P1F1D065SpawnCleanupError)
+
+    init(_ result: Result<Bool, any Error>) {
+        switch result {
+        case .success(true): self = .live
+        case .success(false): self = .absent
+        case .failure(let error): self = .failure(.init(error))
+        }
+    }
+}
+
+private enum P1F1D065SpawnCleanupSignal: Equatable {
+    case accepted(Int32), failed(Int32, P1F1D065SpawnCleanupError)
+    case notAttempted(Int32)
+
+    init(_ attempt: CliSpawnCleanupSignalAttemptV1) {
+        switch attempt.result {
+        case .success?: self = .accepted(attempt.signal)
+        case .failure(let error)?: self = .failed(attempt.signal, .init(error))
+        case nil: self = .notAttempted(attempt.signal)
+        }
+    }
+}
+
+private struct P1F1D065SpawnCleanupCause: Equatable {
+    let phase: CliProcessCleanupFailureV1.Phase
+    let error: P1F1D065SpawnCleanupError
+}
+
+private struct P1F1D065SpawnCleanupReap: Equatable {
+    let status: Int32?
+    let failure: String?
+}
+
+private struct P1F1D065SpawnCleanupObservation: Equatable {
+    var signals: [P1F1D065SpawnCleanupSignal] = [.accepted(SIGKILL), .accepted(SIGCONT)]
+    var probes: [P1F1D065SpawnCleanupProbe] = [.live]
+    var reap: P1F1D065SpawnCleanupReap? = .init(status: 137, failure: nil)
+    var stdoutEOF: Bool? = true
