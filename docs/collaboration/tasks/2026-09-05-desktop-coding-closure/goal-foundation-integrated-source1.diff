+        let nextVersion = try CanonicalContractCodingV1.checkedIncrement(operation.version)
+        try db.execute(sql: """
+            UPDATE desktop_goal_operation SET resultJson=?,version=?,updatedAt=? WHERE id=? AND version=? AND phase='prepared'
