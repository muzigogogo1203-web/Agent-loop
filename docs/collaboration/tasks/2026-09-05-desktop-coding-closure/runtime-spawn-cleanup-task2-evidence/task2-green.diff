+private enum P1F1D065SpawnCleanupError: Equatable {
+    case authority(Int32)
+    case backend(CliProcessBackendError)
+    case sentinel(P1F1D065SpawnCleanupSentinel)
+    case unexpected(String)
+
+    init(_ error: any Error) {
+        if case .processSignal(let number)? = error as? EngineRuntimeAuthorityErrorV1 {
+            self = .authority(number)
+        } else if let error = error as? CliProcessBackendError {
+            self = .backend(error)
+        } else if let error = error as? P1F1D065SpawnCleanupSentinel {
+            self = .sentinel(error)
+        } else {
