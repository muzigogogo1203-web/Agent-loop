+private final class P1F1D065SpawnCleanupInspector:
+    EngineRuntimeProcessInspectingV1, @unchecked Sendable
+{
+    // This key belongs only to the private registry below. Never use a syscall.
+    static let group: Int32 = 2_000_065
+    private let lock = NSLock()
+    private let steps: [P1F1D065SpawnCleanupStep]
+    private var cursor = 0
+    private var violations = 0
+
+    init(_ steps: [P1F1D065SpawnCleanupStep]) { self.steps = steps }
+
+    private func next(group: Int32, signal: Int32?) throws -> P1F1D065SpawnCleanupStep {
+        try lock.withLock {
+            guard group == Self.group, cursor < steps.count else {
+                violations += 1
+                throw P1F1D065SpawnCleanupSentinel.unexpectedCall
+            }
+            let step = steps[cursor]
+            let matches: Bool
+            switch (step, signal) {
+            case (.probe, nil): matches = true
+            case (.signal(let expected, _), let actual?): matches = expected == actual
+            default: matches = false
+            }
+            guard matches else {
+                violations += 1
+                throw P1F1D065SpawnCleanupSentinel.unexpectedCall
+            }
+            cursor += 1
+            return step
+        }
+    }
+
+    func snapshots() throws -> [EngineRuntimeProcessSnapshotV1] {
+        lock.withLock { violations += 1 }
+        throw P1F1D065SpawnCleanupSentinel.unexpectedCall
+    }
+
+    func send(signal: Int32, processGroupId: Int32) throws {
+        guard case .signal(_, let result) = try next(group: processGroupId, signal: signal)
+        else { throw P1F1D065SpawnCleanupSentinel.unexpectedCall }
+        try result.get()
+    }
+
+    func processGroupExists(_ processGroupId: Int32) throws -> Bool {
+        guard case .probe(let result) = try next(group: processGroupId, signal: nil)
+        else { throw P1F1D065SpawnCleanupSentinel.unexpectedCall }
+        return try result.get()
+    }
+
+    var snapshot: (remaining: Int, violations: Int) {
+        lock.withLock { (steps.count - cursor, violations) }
+    }
+}
