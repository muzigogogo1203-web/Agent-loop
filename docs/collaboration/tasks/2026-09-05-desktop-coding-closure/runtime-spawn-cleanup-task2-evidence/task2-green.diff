+private func p1f1d065RunSpawnCleanup(
+    _ steps: [P1F1D065SpawnCleanupStep],
+    reapResult: CliProcessReapResult = .init(status: 137, failure: nil),
+    stdoutEOF: Bool = true, stderrEOF: Bool = true, missingTask: String? = nil
+) async throws -> P1F1D065SpawnCleanupObservation {
+    let inspector = P1F1D065SpawnCleanupInspector(steps)
+    let registry = ShellProcessRegistry()
+    let group = P1F1D065SpawnCleanupInspector.group
+    registry.register(-group)
+    let reapTask: Task<CliProcessReapResult, Never>? = missingTask == "reap"
+        ? nil : Task { reapResult }
+    let stdoutTask: Task<Bool, Never>? = missingTask == "stdout"
+        ? nil : Task { stdoutEOF }
+    let stderrTask: Task<Bool, Never>? = missingTask == "stderr"
+        ? nil : Task { stderrEOF }
+    let report = await CliProcessSpawnCleanupV1.runRegistered(
+        executionId: "no-child-spawn-cleanup", processGroupID: group,
+        processInspector: inspector, reapTask: reapTask,
+        stdoutTask: stdoutTask, stderrTask: stderrTask,
+        registry: registry, diagnosticOwner: UUID()
+    )
+
+    // No assertion or throw can escape before every created task is joined.
+    var joined = 0
+    if let reapTask { _ = await reapTask.value; joined += 1 }
+    if let stdoutTask { _ = await stdoutTask.value; joined += 1 }
+    if let stderrTask { _ = await stderrTask.value; joined += 1 }
+    let activeCount = registry.activeCount
+    registry.unregister(-group)
+    let script = inspector.snapshot
+    let observed = P1F1D065SpawnCleanupObservation(
+        signals: report.signals.map(P1F1D065SpawnCleanupSignal.init),
+        probes: report.preJoinProbes.map(P1F1D065SpawnCleanupProbe.init),
+        reap: report.reap.map { .init(status: $0.status, failure: $0.failure) },
+        stdoutEOF: report.stdoutEOF, stderrEOF: report.stderrEOF,
+        finalProbe: report.finalGroupExists.map(P1F1D065SpawnCleanupProbe.init),
+        reconciled: report.reconciledFinalCONT,
+        causes: report.causes.map { .init(phase: $0.phase, error: .init($0.underlying)) },
+        registryRetained: report.registryRetained, activeCount: activeCount,
+        remainingCalls: script.remaining
+    )
+    print("065 SPAWN CLEANUP no-child=true joined=\(joined) missing=\(missingTask ?? "none") violations=\(script.violations) observation=\(observed)")
+    try #require(joined == (missingTask == nil ? 3 : 2))
+    try #require(registry.activeCount == 0 && script.violations == 0)
+    try #require(report.executionId == "no-child-spawn-cleanup" && report.processGroupID == group)
+    return observed
+}
