+    print(
+        "HELP PROBE PROGRESS PHASES "
+            + "cancelled=\(cancellationObserved) "
+            + "invocations=\(invocation.invocationCount) "
+            + "arguments=\(String(describing: invocation.arguments)) "
+            + "entered=\(snapshot.readEntered) "
