+            let writeError = written < 0 ? errno : nil
+            let closeResult = Darwin.close(ownedWriter)
+            let closeError = closeResult == 0 ? nil : errno
+            state.recordWrite(
+                count: written,
+                errorNumber: writeError,
+                closeError: closeError
+            )
+        } else {
+            state.markEntryTimedOut()
+            let closeResult = Darwin.close(ownedWriter)
+            let closeError = closeResult == 0 ? nil : errno
+            state.recordWrite(
+                count: nil,
+                errorNumber: nil,
+                closeError: closeError
+            )
