+        while !state.hasReadEntered(), ContinuousClock.now < entryDeadline {
+            Thread.sleep(forTimeInterval: 0.001)
+        }
+
+        if state.hasReadEntered() {
+            let sibling = Task.detached {
+                state.markSiblingProgressed()
+            }
